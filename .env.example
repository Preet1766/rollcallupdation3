# Copy this file to .env and fill in the two values from your Supabase project:
#   Project Settings -> API
#
# Only the PUBLIC (publishable / anon) key belongs here. It is designed to be
# visible in the browser; the database protects the data with row-level
# security. NEVER put a service_role key or a database password in this file.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
